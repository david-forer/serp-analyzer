# Copy this file to .env and add your own keys

# Search data. DataForSEO is used when both lines below are filled in.
# Find them at app.dataforseo.com under API Access. The password is the API password, not your login password.
DATAFORSEO_LOGIN=your_dataforseo_login_email
DATAFORSEO_PASSWORD=your_dataforseo_api_password

# Fallback search data, used only when the DataForSEO lines are empty. Does not return AI Overviews.
SERPER_API_KEY=your_serper_key_here

# AI classification
OPENAI_API_KEY=your_openai_key_here
